# ── Runtime ──
PORT=3333
HOST=0.0.0.0

# ── Session defaults ──
SESSION_TIMEOUT_MINUTES=30
MAX_SESSIONS=10
MAX_CONTAINER_MEMORY=512m
MAX_CONTAINER_CPU=1.0

# ── Docker ──
DOCKER_SOCKET=/var/run/docker.sock

# ── Rate limiting ──
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ── Repo limits ──
MAX_REPO_SIZE_MB=500
CLONE_TIMEOUT_MS=60000

# ── GitHub (optional, raises rate limits) ──
GITHUB_TOKEN=
